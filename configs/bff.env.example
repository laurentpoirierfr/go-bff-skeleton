# Variables d'environnement du BFF
#
# Généré à partir du code (internal/platform/config) : ne pas modifier à la
# main, lancer « make config-reference ». Les valeurs sont celles du
# développement local ; la documentation complète des clés est dans
# configs/reference.yaml.
#
# Les variables ROUTES_* surchargent des routes déclarées dans le fichier
# YAML (par exemple la cible d'une API selon l'environnement).
#
# Utilisation :
#   set -a; . ./configs/bff.env.example; set +a     (shell, avant go run)
#   docker run --env-file configs/bff.env.example …
#   VS Code : "envFile" dans launch.json

# --- service

# Nom du service dans les journaux et les traces
SERVICE_NAME=bff

# --- http

# Adresse d'écoute
HTTP_ADDRESS=:8080

# --- web

# Politique de sécurité du contenu (Content-Security-Policy) des pages
# (valeur à espaces : à définir hors de ce fichier si besoin)
# WEB_CSP=default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# --- proxy

# Délai d'une requête vers un backend, si la route n'en fixe pas
PROXY_DEFAULT_TIMEOUT=10s

# Taille maximale du corps d'une requête relayée (1 Mio)
PROXY_MAX_BODY_BYTES=1048576

# --- log

# Niveau : debug, info, warn ou error
LOG_LEVEL=info

# Format : json (production) ou text (développement)
LOG_FORMAT=text

# --- telemetry

# Envoyer les traces au collecteur OpenTelemetry
TELEMETRY_ENABLED=true

# URL du collecteur, en OTLP HTTP
TELEMETRY_ENDPOINT=http://localhost:4318

# Part des nouvelles traces gardées, de 0 à 1 (une trace commencée ailleurs garde sa décision)
TELEMETRY_SAMPLE_RATIO=1

# --- shutdown

# Temps laissé aux traitements en cours, à l'arrêt
SHUTDOWN_TIMEOUT=15s

# --- routes

# Préfixe des chemins relayés (sous /api/)
ROUTES_ORDERS_PREFIX=/api/orders

# URL du backend qui remplace le préfixe
ROUTES_ORDERS_TARGET=http://localhost:8092/api/v1/orders

# Délai de cette route (facultatif : proxy.default_timeout)
ROUTES_ORDERS_TIMEOUT=10s

# Préfixe des chemins relayés (sous /api/)
ROUTES_USERS_PREFIX=/api/users

# URL du backend qui remplace le préfixe
ROUTES_USERS_TARGET=http://localhost:8091/api/v1/users

# Délai de cette route (facultatif : proxy.default_timeout)
ROUTES_USERS_TIMEOUT=5s
